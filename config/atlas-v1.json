{
  "profile": "atlas-v1",
  "rules": [
    {"id": "hands-visible", "signal": "hand.visibility_fraction", "operator": ">=", "threshold": 0.6, "severity": "reject"},
    {"id": "extended-idle", "signal": "idle.fraction", "operator": "<=", "threshold": 0.5, "severity": "reject"},
    {"id": "hand-speed", "signal": "hand.motion_speed_p95", "operator": "<=", "threshold": 0.75, "severity": "reject"},
    {"id": "repetitive-motion", "signal": "motion.repetition_score", "operator": "<=", "threshold": 0.85, "severity": "reject"},
    {"id": "corrupt-video", "signal": "camera.corrupt", "operator": "==", "threshold": false, "severity": "reject"},
    {"id": "black-covered", "signal": "camera.black_covered", "operator": "==", "threshold": false, "severity": "reject"},
    {"id": "blur-warning", "signal": "camera.blur_fraction", "operator": "<=", "threshold": 0.2, "severity": "warn"},
    {"id": "exposure-warning", "signal": "camera.exposure_fraction", "operator": "<=", "threshold": 0.2, "severity": "warn"},
    {"id": "translation-shake", "signal": "camera.shake_p95_translation", "operator": "<=", "threshold": 0.03, "severity": "reject"},
    {"id": "rotation-shake", "signal": "camera.shake_p95_rotation", "operator": "<=", "threshold": 5.0, "severity": "reject"}
  ]
}
